    <div class="placeholder photo" style="height: 190px;">Camping Trip Photos</div>
    <div class="placeholder photo" style="height: 190px;">Pinewood Derby Photos</div>
    <div class="placeholder photo" style="height: 190px;">Blue &amp; Gold Banquet</div>
    <div class="placeholder photo" style="height: 190px;">Pack Meetings</div>
  </div>
</Layout>
