---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Welcome to BSA Cub Scout Pack 3472 in Leawood, KS — an active, outdoor-focused pack for boys and girls in grades K-5.">
  <div class="two-col">
    <section>
      <h1 class="section-title">Welcome!</h1>
      <p>
        We are glad you have found your way to the Pack 3472 website! Our pack welcomes both boys and girls in
        grades K&ndash;5! We are a very active, outdoor focused pack! Our Cub Scouts attend Prairie Star, Sunrise Point,
        Overland Trail, Barstow, AMI, and multiple other schools so all are welcome!!
      </p>
      <p>
        If you and your son/daughter would like to learn more about Cub Scouting, we'd love to have you visit one of
        our monthly Pack meetings where we gather all of the kids together for fun activities!
      </p>
      <p><strong>WHEN:</strong> 6:30-7:45p on the second Tuesday of every month</p>
      <p>
        <strong>CHARTERING ORGANIZATION:</strong> PSE PTO<br />
        Prairie Star Elementary School (West side cafeteria, through YMCA entrance)<br />
        3800 W 143rd St, Leawood, KS 66224
      </p>

      <div class="cta-box">
        <p class="cta-title">Want to join us?</p>
        <a class="cta-button" href="/contact">CONTACT US</a>
      </div>

      <div class="events-box">
        <h3>Upcoming Events</h3>
        <div class="event-item">
          <strong>November Pack Meeting</strong>
          November 12, 2024
        </div>
        <div class="event-item">
          <strong>December Pack Meeting</strong>
          December 10, 2024
        </div>
        <div class="event-item">
          <strong>Pinewood Derby</strong>
          January 11, 2025
        </div>
        <div class="event-item">
          <strong>Blue &amp; Gold Banquet</strong>
          February 11, 2025
        </div>
      </div>
    </section>

    <section>
      <h2 class="page-title">Pack 3472 In Action!</h2>
      <div class="placeholder video">Video / Slideshow</div>

      <div class="ranks-strip">
        Cub Scout rank adventures for Lions, Tigers, Wolves, Bears, Webelos, and Arrow of Light.
      </div>

      <h2 class="section-title">Den Meetings</h2>
      <div class="den-list">
        Lions = 2nd Tuesday<br />
        Tigers = 1st Thursday<br />
        Wolves = 4th Tuesday<br />
        Bears = 4th Thursday<br />
        Webelos 1 = 1st Thursday<br />
        Arrow of Light = 3rd Tuesday
      </div>

      <h2 class="page-title" style="margin-top: 18px;">Pinewood Derby</h2>
      <div class="placeholder photo">Pinewood Derby Photos</div>
    </section>
  </div>
</Layout>
