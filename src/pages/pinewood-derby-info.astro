---
import Layout from '../layouts/Layout.astro';

const rules = [
  { label: 'Car Kit', detail: 'Must use the official BSA Pinewood Derby kit (available at the Scout Store)' },
  { label: 'Weight', detail: 'Maximum 5.0 oz (141.75 g) — weigh-in occurs at check-in' },
  { label: 'Width', detail: 'Maximum 2¾ inches (6.98 cm)' },
  { label: 'Length', detail: 'Maximum 7 inches (17.78 cm) — must fit on the track' },
  { label: 'Height', detail: 'Maximum 3 inches (7.62 cm)' },
  { label: 'Clearance', detail: 'Minimum ⅜ inch (9.5 mm) clearance between car bottom and track' },
  { label: 'Axles & Wheels', detail: 'Must use the axles and wheels from the official BSA kit' },
  { label: 'Propulsion', detail: 'No springs, rubber bands, or any added propulsion — gravity only!' },
];
---

<Layout title="Pinewood Derby Info" description="Learn about the BSA Pinewood Derby tradition, official car rules, and race day details for Pack 3472 in Leawood, KS.">
  <h1 class="page-title">Pinewood Derby Info</h1>
  <hr class="rule" />

  <p>
    The Pinewood Derby is one of the most beloved traditions in Cub Scouting. Since its creation in 1953, Scouts and
    families have gathered to build, race, and celebrate handcrafted wooden cars.
  </p>

  <div class="events-box" style="margin-bottom: 16px; border-color: #8b7d50;">
    <h3>A BSA Tradition Since 1953</h3>
    <p>
      Each Scout receives an official BSA kit containing a block of pine wood, plastic wheels, and metal axles. From
      that starting point, the Scout (with help from a parent/guardian) carves, sands, paints, and decorates a custom
      car, then races it down a gravity-powered track.
    </p>
  </div>

  <h2 class="section-title">Official Car Rules</h2>
  <div class="paper-box">
    {rules.map((rule) => (
      <p><strong style="color: #cc6600;">{rule.label}:</strong> {rule.detail}</p>
    ))}
  </div>

  <p style="margin-top: 16px;">
    * Pack 3472 may adopt additional local rules. Check with your Den Leader for the latest details.
  </p>
</Layout>
