---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Contact BSA Cub Scout Pack 3472 in Leawood, KS — reach out to our Cubmaster with any questions.">
  <div class="two-col">
    <section>
      <h1 class="page-title">Contact Us:</h1>
      <p style="font-family: Georgia, serif; font-size: 1.4rem; color: #cc6600; margin: 4px 0 14px;">PACK 3472</p>
      <p>
        Fill out this form and one of our leaders will get back with you soon. You can also email us directly at
        <a href="mailto:cubmaster@pack3472.org">cubmaster@pack3472.org</a>.
      </p>
      <p>
        We meet from 6:30-7:45p on the second Tuesday of each month at Prairie Star Elementary School,
        3800 W 143rd St, Leawood, KS 66224.
      </p>
    </section>

    <section>
      <form action="https://formspree.io/f/pack3472contact" method="POST" class="contact-form">
        <label for="name">Name *</label>
        <input type="text" id="name" name="name" required autocomplete="name" />

        <label for="email">Email *</label>
        <input type="email" id="email" name="email" required autocomplete="email" />

        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" />

        <label for="message">Message</label>
        <textarea id="message" name="message" required></textarea>

        <button type="submit" class="button-olive" style="float: right;">Send</button>
      </form>
    </section>
  </div>
</Layout>
