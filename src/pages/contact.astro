---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Contact BSA Cub Scout Pack 3472 in Leawood, KS — reach out to our Cubmaster with any questions.">

  <!-- Page Header -->
  <div class="bg-[#003F87] text-white py-10 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold">Contact Us</h1>
      <p class="text-blue-200 mt-2">Pack 3472 &mdash; Leawood, KS</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-12">

    <div class="grid sm:grid-cols-2 gap-12">

      <!-- Left: Form -->
      <div>
        <h2 class="text-2xl font-bold text-[#003F87] mb-2 pb-2 border-b-4 border-[#FFC72C]">Send a Message</h2>
        <p class="text-gray-600 mb-6">
          Fill out the form below and one of our leaders will get back with you!
        </p>

        <form
          action="https://formspree.io/f/pack3472contact"
          method="POST"
          class="space-y-5"
        >
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-700 mb-1">
              Your Name <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#003F87] focus:border-[#003F87] transition-colors"
              placeholder="Jane Smith"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-1">
              Email Address <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#003F87] focus:border-[#003F87] transition-colors"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold text-gray-700 mb-1">
              Subject
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#003F87] focus:border-[#003F87] transition-colors"
              placeholder="Question about joining"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-gray-700 mb-1">
              Message <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#003F87] focus:border-[#003F87] transition-colors resize-y"
              placeholder="How can we help you?"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-[#003F87] text-white font-bold py-3 px-6 rounded-lg hover:bg-[#002d63] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#003F87]"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- Right: Direct Contact + Info -->
      <div>
        <h2 class="text-2xl font-bold text-[#003F87] mb-2 pb-2 border-b-4 border-[#FFC72C]">Other Ways to Reach Us</h2>
        <p class="text-gray-600 mb-6">
          Prefer email? Reach our Cubmaster directly:
        </p>

        <a
          href="mailto:cubmaster@pack3472.org"
          class="flex items-center gap-4 bg-[#FFC72C] text-[#003F87] rounded-xl p-5 font-bold hover:bg-yellow-300 transition-colors mb-8"
        >
          <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          cubmaster@pack3472.org
        </a>

        <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 space-y-4">
          <h3 class="font-bold text-[#003F87]">Pack Meetings</h3>
          <div class="text-gray-700 space-y-1 text-sm">
            <p><strong>When:</strong> 6:30 &ndash; 7:45 PM, second Tuesday of every month</p>
            <p><strong>Where:</strong> Prairie Star Elementary School</p>
            <p class="ml-12 text-gray-500">West side cafeteria (YMCA entrance)</p>
            <p class="ml-12 text-gray-500">3800 W 143rd St, Leawood, KS 66224</p>
          </div>
        </div>

        <div class="mt-6 bg-blue-50 border border-blue-200 rounded-xl p-5">
          <p class="text-sm text-gray-600 leading-relaxed">
            <strong class="text-[#003F87]">New families welcome!</strong> The best way to learn about
            our Pack is to come to a meeting. Drop-ins are encouraged — just bring your child and
            introduce yourselves!
          </p>
        </div>
      </div>

    </div>
  </div>
</Layout>
