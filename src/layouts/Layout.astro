---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'BSA Cub Scout Pack 3472 — Leawood, KS. An active, outdoor-focused pack welcoming boys and girls in grades K-5.' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/pinewood-derby-info', label: 'Pinewood Derby Info' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
  { href: '/restaurant-night', label: 'Restaurant Night' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Pack 3472 — Leawood, KS</title>
  </head>
  <body>
    <aside class="side-nav" aria-label="Main navigation">
      <ul>
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <li>
              <a href={link.href} class:list={{ active: isActive }} aria-current={isActive ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </aside>

    <div class="page-wrap">
      <div class="content-panel">
        <header class="hero-banner">
          <div class="hero-overlay">
            <p class="site-title">PACK 3472</p>
            <p class="site-subtitle">Leawood, KS</p>
          </div>
        </header>

        <main class="page-content">
          <slot />
        </main>

        <footer class="site-footer">
          <p>© 2025 BSA Cub Scout Pack 3472. All rights reserved.</p>
        </footer>
      </div>
    </div>
  </body>
</html>
