---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'BSA Cub Scout Pack 3472 — Leawood, KS. An active, outdoor-focused pack welcoming boys and girls in grades K-5.' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
  { href: '/pinewood-derby-info', label: 'Pinewood Derby' },
  { href: '/contact', label: 'Contact' },
  { href: '/restaurant-night', label: 'Restaurant Night' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Pack 3472 — Leawood, KS</title>
  </head>
  <body class="min-h-screen flex flex-col">

    <!-- Site Header -->
    <header class="bg-[#003F87] text-white shadow-md">
      <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-2">
        <a href="/" class="flex items-center gap-3 hover:opacity-90 transition-opacity">
          <!-- Scout fleur-de-lis SVG icon -->
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="18" cy="18" r="18" fill="#FFC72C"/>
            <path d="M18 5 L21 13 L29 13 L23 18 L25 26 L18 21 L11 26 L13 18 L7 13 L15 13 Z" fill="#003F87"/>
          </svg>
          <div>
            <div class="text-xl font-bold tracking-wide leading-tight">PACK 3472</div>
            <div class="text-sm text-blue-200 leading-tight">Leawood, KS</div>
          </div>
        </a>
        <div class="text-xs text-blue-200 sm:text-right hidden sm:block">
          BSA Cub Scouts
        </div>
      </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-[#002d63] sticky top-0 z-50 shadow-sm" aria-label="Main navigation">
      <div class="max-w-6xl mx-auto px-4">
        <ul class="flex flex-wrap gap-0 justify-center sm:justify-start" role="list">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href ||
              (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'block px-4 py-3 text-sm font-medium transition-colors duration-150 border-b-2',
                    isActive
                      ? 'text-[#FFC72C] border-[#FFC72C]'
                      : 'text-blue-100 border-transparent hover:text-white hover:border-blue-300'
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#003F87] text-white mt-12">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-center sm:text-left">
            <p class="font-semibold">BSA Cub Scout Pack 3472</p>
            <p class="text-blue-200 text-sm">Chartered by Prairie Star Elementary School PTO</p>
            <p class="text-blue-200 text-sm">3800 W 143rd St, Leawood, KS 66224</p>
          </div>
          <div class="text-center sm:text-right">
            <a href="mailto:cubmaster@pack3472.org" class="text-[#FFC72C] hover:text-yellow-300 text-sm transition-colors">
              cubmaster@pack3472.org
            </a>
          </div>
        </div>
        <div class="border-t border-blue-700 mt-6 pt-4 text-center text-blue-300 text-sm">
          &copy; 2025 BSA Cub Scout Pack 3472. All rights reserved.
        </div>
      </div>
    </footer>

  </body>
</html>
